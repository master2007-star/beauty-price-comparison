# Beauty Price Comparison — environment template.
# Copy to .env.local for local dev, or set these in Vercel → Project → Settings → Environment Variables.
# NEVER commit real keys. Any provider left unset is simply skipped (the UI says so honestly).

# Google Shopping providers (at least one is needed for search to return prices).
# Get keys from: serpapi.com, searchapi.io, serper.dev, searlo.tech
SERPAPI_KEY=
SEARCHAPI_KEY=
SERPER_KEY=
SEARLO_KEY=

# Search locale (Google Shopping gl/hl). Defaults: in / en.
REGION=in
LANGUAGE=en

# Optional app lock. When set, visitors must enter this passcode before the app
# (and its APIs) respond. When unset, there is no lock screen at all.
APP_PASSCODE=

# Optional signing secret for the lock session cookie. When unset, a key is
# derived from APP_PASSCODE. Set a long random value in production.
SESSION_SECRET=
