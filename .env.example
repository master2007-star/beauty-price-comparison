# Beauty Price Comparison — environment template.
# Copy to .env.local for local dev, or set these in Vercel → Project → Settings → Environment Variables.
# NEVER commit real keys. Any provider left unset is simply skipped (the UI says so honestly).

# Google Shopping providers (at least one is needed for search to return prices).
# Get keys from: serpapi.com, searchapi.io, serper.dev, searlo.tech
SERPAPI_KEY=
SEARCHAPI_KEY=
SERPER_KEY=
SEARLO_KEY=

# Search locale (Google Shopping gl/hl). Defaults: in / en.
REGION=in
LANGUAGE=en

# Optional app lock. When set, visitors must enter this passcode before the app
# (and its APIs) respond. When unset, there is no lock screen at all.
APP_PASSCODE=

# Optional signing secret for the lock session cookie. When unset, a key is
# derived from APP_PASSCODE. Set a long random value in production.
SESSION_SECRET=

# Optional Google login (Auth.js v5, JWT sessions, no database). All three
# must be set for the sign-in button to appear; without them the site works
# exactly as before with no login UI. See "Google login (optional)" in
# README.md for the Google Cloud Console setup. The redirect URI to
# register is https://beauty-price-comparison.vercel.app/api/auth/callback/google
# (http://localhost:3000/api/auth/callback/google for local dev).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_SECRET=

# Optional Gemini AI (advisor chat + smart search). When GEMINI_API_KEY is
# unset, no AI UI renders and the app behaves exactly as before. Get a
# free key at https://aistudio.google.com/ ("Get API key"). GEMINI_MODEL
# is an optional override; the default is gemini-2.5-flash-lite. See
# "Gemini AI (optional)" in README.md.
GEMINI_API_KEY=
GEMINI_MODEL=

# Optional Postgres database (price history tracking & trends).
# Supports Neon / Vercel Postgres connection strings.
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
